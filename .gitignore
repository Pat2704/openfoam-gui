# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# electron build inputs and outputs
# electron/resources/ is regenerated by `npm run electron:prepare`
# (it holds the assembled standalone build + the bundled node.exe)
electron/resources/
dist-electron/
dist/
# electron-builder regenerates this on every build; electron/package.json
# has no dependencies, so it carries no information worth committing
electron/package-lock.json

# local env overrides (.env itself is committed: it only disables telemetry)
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
